//
// SPDX-License-Identifier: Apache-2.0
//
// Base policy with permissive entitlements (for diff demo).
//

security module com.example.sample {
    // Permissive filesystem access
    entitle module to fs.read("/", "**");

    // Permissive network access
    entitle module to network.outbound;

    // Thread creation
    entitle module to threads.create;

    // Native library loading
    entitle module to native.load;
}
