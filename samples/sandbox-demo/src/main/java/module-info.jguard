security module io.jguard.samples.sandbox {

    // Grant filesystem read access to the project's own source directory
    // Uses relative path (resolved from JVM working directory)
    entitle module to fs.read("src", "**/*");

    // Grant filesystem write access to build output directory
    // Use "**" to match the directory itself and all contents
    entitle module to fs.write("build/test-output", "**");

    // Grant network outbound to specific packages
    // The .net package can connect to any host/port
    entitle io.jguard.samples.sandbox.net to network.outbound;

    // The .net package needs fs.read for JDK security config files
    // (JDK reads java.security during network class initialization)
    // Using narrower paths than root for better security
    entitle io.jguard.samples.sandbox.net to fs.read("/usr", "**");
    entitle io.jguard.samples.sandbox.net to fs.read("/Library", "**");

    // The .net.restricted subpackage can ONLY connect to *.example.com on ports 80-443
    // This demonstrates host glob pattern + port range filtering
    entitle io.jguard.samples.sandbox.net.restricted to network.outbound("*.example.com", "80-443");

    // Grant network listen to specific packages
    entitle io.jguard.samples.sandbox.net to network.listen;

    // Grant thread creation to the worker package hierarchy
    entitle io.jguard.samples.sandbox.worker.. to threads.create;

    // Grant native library loading to the nativelib package
    entitle io.jguard.samples.sandbox.nativelib.. to native.load;

    // Grant system property read access for the module
    // This is needed because:
    // 1. JDK classes read properties during class initialization (e.g., java.net.InetAddress)
    // 2. These reads are attributed to the application code that triggered the initialization
    // 3. The demo uses paths from user.home and java.io.tmpdir
    // In production, you may want to use more specific patterns.
    entitle module to system.property.read;

    // Grant environment variable read access to specific package
    // The .config package can read any env var
    entitle io.jguard.samples.sandbox.config to env.read;

    // Grant system property write access to specific package
    // The .config package can write properties matching "app.**" (any depth)
    entitle io.jguard.samples.sandbox.config to system.property.write("app.**");

    // ========== New v0.3 Capabilities ==========

    // Grant process execution to specific package with restricted command
    // Only allows running /bin/echo or /usr/bin/echo
    entitle io.jguard.samples.sandbox.process to process.exec("/bin/echo");
    entitle io.jguard.samples.sandbox.process to process.exec("/usr/bin/echo");

    // Grant hard link creation to specific package within build directory
    entitle io.jguard.samples.sandbox.fs to fs.hardlink("build/test-output", "**");

    // Grant crypto provider modification to security package
    // Note: Package name contains "security" to demonstrate contextual keywords work
    entitle io.jguard.samples.sandbox.security to crypto.provider;

    // Grant runtime lifecycle control to lifecycle package
    // These capabilities protect server uptime by controlling:
    // - Who can terminate the JVM (prevents rogue libraries from calling System.exit())
    // - Who can register shutdown hooks (prevents interference with graceful shutdown)
    entitle io.jguard.samples.sandbox.lifecycle to runtime.exit;
    entitle io.jguard.samples.sandbox.lifecycle to runtime.shutdown_hook;

}
